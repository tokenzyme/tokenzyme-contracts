# Copy this file to .env and fill in the values.
#
#   cp .env.template .env
#
# .env is git-ignored. Never commit real credentials.
# None of these are needed to compile the contracts or run the test suite.

# Private key of the deploying account, without the 0x prefix requirement enforced —
# use whatever format ethers accepts. Needed only for deployments and for running a
# funded fork. NEVER COMMIT THIS.
DEPLOYER_PRIVATE_KEY=""

# The account that receives protocol trade fees and the full-range liquidity position
# minted when a token migrates to the DEX.
#
# Required for any deployment, with no default on purpose: deploying with someone
# else's address hands them the economics of your launchpad. Prefer a multisig — see
# "The owner is fully privileged" in SECURITY.md.
FEE_RECIPIENT=""

# Block explorer API key, used by `yarn contracts:verify`.
# For Sonic, get one at https://sonicscan.org.
ETHERSCAN_API_KEY=""
