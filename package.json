{
  "name": "tokenzyme-contracts",
  "version": "1.0.0",
  "packageManager": "yarn@4.9.1",
  "private": true,
  "license": "MIT",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "files": [
    "lib"
  ],
  "scripts": {
    "build": "rm -Rf ./lib && yarn contracts:compile && tsc -p tsconfig.build.json",
    "contracts:compile": "rm -Rf ./artifacts ./cache ./typechain ../tokenzyme-core/src/generated/typechain ../tokenzyme-app/src/generated/typechain && hardhat compile && cp -Rf ./typechain ../tokenzyme-core/src/generated && cp -Rf ./typechain ../tokenzyme-app/src/generated",
    "contracts:deploy": "yarn build && hardhat deployContracts --network mainnet",
    "contracts:deploy:fork": "yarn build && hardhat deployContracts --network fork",
    "contracts:deploy:testnet": "yarn build && hardhat deployContracts --network testnet",
    "contracts:deploy:testnetLegacy": "yarn build && hardhat deployContracts --network testnetLegacy",
    "contracts:size": "hardhat size-contracts",
    "contracts:verify": "hardhat ignition verify --include-unrelated-contracts",
    "format": "prettier --write './**/*.{ts,cts,mts,js,cjs,mjs,json,yml,yaml}'",
    "lint": "eslint .",
    "test": "TEST=true && hardhat test",
    "test:fork:startNode": "FORK=true && yarn hardhat node"
  },
  "dependencies": {
    "@chainlink/contracts": "1.4.0",
    "@nomicfoundation/hardhat-chai-matchers": "2.0.8",
    "@nomicfoundation/hardhat-ethers": "3.0.8",
    "@nomicfoundation/hardhat-ignition": "0.15.11",
    "@nomicfoundation/hardhat-ignition-ethers": "0.15.11",
    "@nomicfoundation/hardhat-network-helpers": "1.0.12",
    "@nomicfoundation/hardhat-toolbox": "5.0.0",
    "@nomicfoundation/hardhat-verify": "2.0.14",
    "@nomicfoundation/ignition-core": "0.15.11",
    "@openzeppelin/contracts": "5.3.0",
    "@openzeppelin/contracts-upgradeable": "5.3.0",
    "@typechain/ethers-v6": "0.5.1",
    "@typechain/hardhat": "9.1.0",
    "dotenv": "16.5.0",
    "ethers": "6.14.3",
    "hardhat": "2.24.2",
    "hardhat-contract-sizer": "2.10.0",
    "hardhat-dependency-compiler": "1.2.1"
  },
  "devDependencies": {
    "@types/chai": "4.3.20",
    "@types/mocha": "10.0.10",
    "@types/node": "22.15.29",
    "@typescript-eslint/eslint-plugin": "7.18.0",
    "@typescript-eslint/parser": "7.18.0",
    "chai": "4.5.0",
    "eslint": "8.57.1",
    "eslint-config-airbnb-base": "15.0.0",
    "eslint-config-airbnb-typescript": "18.0.0",
    "eslint-config-prettier": "9.1.0",
    "eslint-import-resolver-typescript": "3.10.1",
    "eslint-plugin-deprecation": "2.0.0",
    "eslint-plugin-import": "2.31.0",
    "eslint-plugin-prettier": "5.4.1",
    "prettier": "3.5.3",
    "solidity-coverage": "0.8.16",
    "ts-node": "10.9.2",
    "typechain": "8.3.2",
    "typescript": "5.8.3"
  }
}
